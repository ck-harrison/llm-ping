{
  "manifest_version": 3,
  "name": "LLM Ping",
  "version": "3.7.0",
  "description": "Ping responses between AI chatbots — bounce, broadcast, or start a Ping Pong conversation.",
  "minimum_chrome_version": "102",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["toast.css"],
      "run_at": "document_idle"
    }
  ]
}
